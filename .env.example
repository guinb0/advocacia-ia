# Modelo de configuração. Copie para `.env` e preencha.
#   cp .env.example .env
#
# O `.env` real fica fora do git. Nunca commite chave nem senha aqui.

# ─────────────────────────────────────────────── banco vetorial (pgvector)
# Aplique sql/001_criar_banco_vetorial.sql antes do primeiro uso.
PGVECTOR_HOST=
PGVECTOR_PORT=5432
PGVECTOR_DB=advocacia_ia
PGVECTOR_USER=
PGVECTOR_PASSWORD=
PGVECTOR_SSLMODE=prefer
PGVECTOR_TABLE=knowledge_chunks
DATABASE_URL=
# Persistência dos estados/resultados Celery. Se vazio, usa DATABASE_URL.
JOBS_DATABASE_URL=postgresql://advocacia:advocacia_local@localhost:5434/advocacia_jobs
# Banco local produzido pelo pipeline jurimetria-trt8.
JURIMETRIA_DATABASE_URL=postgresql://juri:juri@localhost:5433/juri

# ───────────────────────────────────────────────────────────── filas e observabilidade
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
# O Paddle atual é CPU. Troque para 1 somente junto da wheel CUDA ajustada/testada.
OCR_USA_GPU=0
OCR_ENABLE_MKLDNN=0
OCR_MKLDNN_CACHE_CAPACITY=10
OCR_CPU_THREADS=1
OCR_DETECTOR=PP-OCRv5_mobile_det
OCR_RECONHECEDOR=latin_PP-OCRv5_mobile_rec
# Vazio usa a resolução nativa dos documentos.
OCR_DET_LADO_MAXIMO=
OCR_DOC_ORIENTATION=1
OCR_TEXTLINE_ORIENTATION=1
OCR_CROPS_DOCUMENTO=0
OCR_COMPROVANTE_ALTURA=0.55
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=advocacia-api
OTEL_SERVICE_VERSION=dev

# ────────────────────────────────────────────────────────────── LLM
# Triagem da entrevista. Sem chave, cai no classificador local por termos.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────── embeddings
# A dimensão precisa bater com as colunas vector(N) do banco. Trocar de modelo
# depois obriga a recriar as colunas e reindexar.
EMBEDDINGS_MODEL_NAME=google/gemini-embedding-001
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSIONS=1536

# ────────────────────────────────────────────────── autenticação
# Vazio DESLIGA a autenticação e abre a API — só para desenvolvimento.
# URLs publicas. Em homologacao/producao use HTTPS e os dominios publicados.
# Para testar em outro aparelho na mesma rede, use o IP da maquina host.
APP_BIND_HOST=0.0.0.0
APP_PUBLIC_URL=http://localhost:3000
OCR_API_PUBLIC_URL=http://127.0.0.1:8100
TRANSCRICAO_PUBLIC_URL=http://127.0.0.1:8200
JITSI_PUBLIC_URL=http://localhost:8081
JITSI_ADVERTISE_IPS=127.0.0.1

# ────────────────────────────────────────────────── autenticação (JWT)
# Quem assina a sessão é o próprio backend (app/auth.py), no padrão dos demais
# projetos da Level. JWT_SECRET VAZIO desliga a autenticação e abre a API — é o
# que o `iniciar.ps1 -SemAuth` faz. Em produção, gere um segredo longo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=http://localhost:8100/
JWT_AUDIENCE=http://localhost:8100/
JWT_HORAS=24

# O cookie da sessão. `Secure=1` exige HTTPS (produção); em desenvolvimento, 0.
# `lax` basta quando front e API compartilham o host; use `none` (com Secure=1)
# quando estiverem em domínios diferentes, como no DFLegal.
JWT_COOKIE=JwtToken
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=lax
JWT_COOKIE_DOMAIN=

# A conta inicial, criada só quando a tabela de usuários está vazia — senão um
# ambiente novo sobe com a autenticação ligada e nenhum jeito de entrar. Sem
# senha aqui, ela nasce com a padrão (123456) e a tela exige a troca.
ACERVO_ADMIN_EMAIL=admin@acervo.local
ACERVO_ADMIN_SENHA=

# ───────────────────────────────────────────────── portal do cliente
PORTAL_SEGREDO=
URL_PORTAL=http://localhost:3000

# ──────────────────────────────────────────── agente jurídico (ia-juridica)
# Outro serviço, com banco próprio: guarda o Case State (fato com proveniência,
# classificação, pendência do playbook, jurisprudência) e roda os modelos.
# Vazio DESLIGA a ligação: o OCR continua inteiro e a aba Dossiê explica que o
# agente não está configurado — nunca mostra caso vazio como se não houvesse nada.
# Repositório irmão `ia-juridica`; o iniciar.ps1 sobe API + worker na 8011
# quando essa URL está preenchida e ia-juridica/.env existe.
AGENTE_API_URL=http://127.0.0.1:8011
# Bearer opcional. Enquanto o agente roda com AUTH_ENABLED=false, deixe vazio;
# quando o login passar a emitir `organization_id`, é o token do advogado que
# atravessa daqui (ver docs/PLANO-BANCOS.md).
AGENTE_TOKEN=
AGENTE_ORGANIZACAO=
# Jurisdição atribuída ao caso espelhado. É ela que restringe quais precedentes a
# pesquisa pode usar — sem ela a busca traz acórdão de outro regional.
AGENTE_JURISDICAO_PADRAO=TRT8
AGENTE_TIMEOUT=20
AGENTE_TIMEOUT_ENVIO=60

# ──────────────────────────────────────────────────────────── app
ORIGENS_PERMITIDAS=http://localhost:3000,http://127.0.0.1:3000
# `localhost` e não `127.0.0.1`: o cookie de sessão só acompanha a chamada se a
# API estiver no mesmo site do front, e para o navegador esses dois são hosts
# diferentes. Trocar de volta quebra o login sem dar erro claro.
NEXT_PUBLIC_OCR_API=http://localhost:8100
# Somente desenvolvimento local: 1 abre a carteira sem login.
AUTH_DESATIVADA=0
NEXT_PUBLIC_AUTH_DESATIVADA=0
# A API síncrona não aquece uma segunda cópia; `/extrair/jobs` usa o worker OCR.
OCR_AQUECER_API=0
# Teto cumulativo para a rede de segurança 90/180/270. Impede que uma foto ruim
# faça quatro inferências lentas e chegue novamente a ~200 segundos. Zero desliga.
OCR_ORIENTATION_FALLBACK_BUDGET_S=45

# ────────────────────────────────────── assinatura eletrônica (ZapSign)
# Vazio DESLIGA o envio para assinatura: o contrato continua sendo gerado e
# baixado, e a tela explica que falta a chave. Token em app.zapsign.com.br,
# Configurações → Integrações → API.
# Desenvolvimento: use o token da conta sandbox. Ele nao e intercambiavel com
# o token de producao e os documentos gerados nao possuem validade juridica.
ZAPSIGN_TEST_API_TOKEN=
ZAPSIGN_BASE_URL=https://sandbox.api.zapsign.com.br/api/v1
# Somente para uma implantacao deliberadamente configurada com o endpoint de
# producao `https://api.zapsign.com.br/api/v1`.
ZAPSIGN_API_TOKEN=
# Como o signatário se identifica. `assinaturaTela` é só desenhar a assinatura;
# `assinaturaTela-tokenEmail` exige também o código enviado por e-mail.
ZAPSIGN_AUTH_MODE=assinaturaTela
# O escritório como segundo signatário. Vazio: só o cliente assina pelo sistema.
ZAPSIGN_SIGNATARIO_NOME=
ZAPSIGN_SIGNATARIO_EMAIL=
# `1` manda o convite também por WhatsApp (consome crédito da conta ZapSign).
ZAPSIGN_WHATSAPP=0

# Evolution API — envio do link de avaliação ao cliente. A chave fica somente
# no backend e nunca deve usar o prefixo NEXT_PUBLIC_.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
GOOGLE_AVALIACAO_URL=https://share.google/jejesXtEzd87GKxbU

# ADVBOX: integração oficial somente leitura. Login/senha do painel não servem
# para a API; gere o Bearer Token em Conta e assinatura -> Nossos produtos.
ADVBOX_API_TOKEN=
ADVBOX_BASE_URL=https://app.advbox.com.br/api/v1

# Investigação pública: chave pública vigente publicada pelo CNJ/DataJud.
DATAJUD_API_KEY=

# ─────────────────────────────────────────── transcrição da entrevista
# Serviço separado (app/servico_transcricao.py) — não divide processo com o OCR.
PORTA_TRANSCRICAO=8200
# `medium` por medição no áudio real: o `small` escrevia "Guilherme Inunes" no
# lugar de "Guilherme Nunes" e "o CIDA de Mando Tensão Industrial" no lugar de
# "auxiliar de manutenção industrial" — e a escuta, corretamente, se recusa a
# preencher campo a partir de texto ilegível. Custa ~1,5 GB de VRAM contra
# ~0,5 GB, e é ATÉ mais rápido (31,5x contra 27,1x o tempo real). Faltando
# memória na placa, voltar para `small` aqui resolve sem tocar em código.
WHISPER_MODELO=medium
# `float16` na GPU, `int8` na CPU. O código escolhe sozinho quando isto fica
# vazio; preencher só serve para forçar o contrário do que ele decidiria.
WHISPER_COMPUTE=
WHISPER_DISPOSITIVO=

# Onde fica o áudio gravado da entrevista (padrão: dados/entrevistas). São ~22 MB
# por hora de conversa, em .mp4. É gravação de atendimento, com dado de saúde e
# qualificação do cliente: se apontar para fora de `dados/`, confira antes se o
# destino está fora do git e com o mesmo cuidado de acesso.
PASTA_GRAVACOES=

# Símbolo do escritório no cabeçalho do relatório da entrevista. Vazio: o sistema
# desenha um emblema tipográfico de LARA & MELO (ver app/marca.py). Aponte para
# um PNG/JPG para usar o logotipo real — a proporção é preservada no PDF.
RELATORIO_LOGO=
NEXT_PUBLIC_TRANSCRICAO_API=http://127.0.0.1:8200

# ──────────────────────────────────────────── chamada com o entrevistado
# Servidor Jitsi (Prosody + Jicofo + Videobridge), que sobe à parte:
#   cd ../../docker-jitsi-meet && docker compose up -d
# A porta é 8081 e não a 8000 do padrão porque a 8000 costuma estar ocupada.
#
# Publicando fora da máquina, este endereço precisa ser alcançável pelo celular
# do cliente — `localhost` só funciona nos dois lados na mesma máquina.
NEXT_PUBLIC_JITSI_URL=http://localhost:8081
# Versao das imagens do stack oficial criado automaticamente pelo iniciar.ps1.
# Alias oficial que aponta para a release estavel completa mais recente.
JITSI_IMAGE_VERSION=stable

# ──────────────────────────────────────────── Jitsi JWT
# O Jitsi valida tokens HS256 com estes valores. O secret é compartilhado
# com o Prosody (configurado em docker-jitsi-meet/.env).
JITSI_JWT_APP_ID=level33-chamadas
JITSI_JWT_APP_SECRET=
