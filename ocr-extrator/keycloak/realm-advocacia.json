{
  "realm": "advocacia",
  "enabled": true,
  "displayName": "Acervo — Advocacia IA",
  "loginTheme": "keycloak",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,

  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,

  "passwordPolicy": "",

  "roles": {
    "realm": [
      {
        "name": "advogado",
        "description": "Acessa a carteira completa: casos, documentos e pedidos."
      }
    ]
  },

  "clients": [
    {
      "clientId": "acervo-frontend",
      "name": "Acervo (frontend Next)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-da-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "acervo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "guinb",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Guilherme",
      "lastName": "Nunes Bezerra",
      "email": "guinb@acervo.local",
      "credentials": [
        {
          "type": "password",
          "value": "123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "advogado"
      ]
    }
  ]
}
