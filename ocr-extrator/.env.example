# Modelo de configuração. Copie para `.env` e preencha.
#   cp .env.example .env
#
# O `.env` real fica fora do git. Nunca commite chave nem senha aqui.

# ─────────────────────────────────────────────── banco vetorial (pgvector)
# Aplique sql/001_criar_banco_vetorial.sql antes do primeiro uso.
PGVECTOR_HOST=
PGVECTOR_PORT=5432
PGVECTOR_DB=advocacia_ia
PGVECTOR_USER=
PGVECTOR_PASSWORD=
PGVECTOR_SSLMODE=prefer
PGVECTOR_TABLE=knowledge_chunks
DATABASE_URL=
# Banco local produzido pelo pipeline jurimetria-trt8.
JURIMETRIA_DATABASE_URL=postgresql://juri:juri@localhost:5433/juri

# ────────────────────────────────────────────────────────────── LLM
# Triagem da entrevista. Sem chave, cai no classificador local por termos.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────── embeddings
# A dimensão precisa bater com as colunas vector(N) do banco. Trocar de modelo
# depois obriga a recriar as colunas e reindexar.
EMBEDDINGS_MODEL_NAME=google/gemini-embedding-001
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSIONS=1536

# ────────────────────────────────────────────────── autenticação
# Vazio DESLIGA a autenticação e abre a API — só para desenvolvimento.
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=advocacia
KEYCLOAK_CLIENT_ID=acervo-frontend
KEYCLOAK_AUDIENCE=acervo-api

# ───────────────────────────────────────────────── portal do cliente
PORTAL_SEGREDO=
URL_PORTAL=http://localhost:3000

# ──────────────────────────────────────────────────────────── app
ORIGENS_PERMITIDAS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_OCR_API=http://127.0.0.1:8100
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=advocacia
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=acervo-frontend

# ─────────────────────────────────────────── transcrição da entrevista
# Serviço separado (app/servico_transcricao.py) — não divide processo com o OCR.
PORTA_TRANSCRICAO=8200
WHISPER_MODELO=small
# `float16` na GPU, `int8` na CPU. O código escolhe sozinho quando isto fica
# vazio; preencher só serve para forçar o contrário do que ele decidiria.
WHISPER_COMPUTE=
WHISPER_DISPOSITIVO=
NEXT_PUBLIC_TRANSCRICAO_API=http://127.0.0.1:8200

# ──────────────────────────────────────────── chamada com o entrevistado
# Servidor Jitsi (Prosody + Jicofo + Videobridge), que sobe à parte:
#   cd ../../docker-jitsi-meet && docker compose up -d
# A porta é 8081 e não a 8000 do padrão porque a 8000 costuma estar ocupada.
#
# Publicando fora da máquina, este endereço precisa ser alcançável pelo celular
# do cliente — `localhost` só funciona nos dois lados na mesma máquina.
NEXT_PUBLIC_JITSI_URL=http://localhost:8081
