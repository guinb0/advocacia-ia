# Variaveis do deploy/jitsi/docker-compose.coturn.yml.
#
# O compose usa a forma `${VAR?...}` nas duas primeiras: faltando qualquer uma,
# o servico recusa subir em vez de subir um relay que nao relaya.
#
# POR QUE ISTO E PRIORIDADE, E NAO ITEM DE BACKLOG
#
# Sem TURN, a voz do cliente sai por UDP na 10000 direto para o videobridge.
# Isso funciona no Wi-Fi de casa e falha justamente onde o cliente costuma
# estar: 4G de operadora e rede de empresa. E o sintoma NAO avisa — a sala
# abre, os dois retratos aparecem, o cronometro anda, e ninguem ouve ninguem.
# Foi o que aconteceu na chamada de 15/09/2026.
#
# Conferencia de 30 segundos, com a chamada de pe: abrir `chrome://webrtc-internals`
# e procurar os candidatos ICE. So `host` e `srflx` = nao ha relay, e o proximo
# cliente em 4G repete o problema. Com o coturn de pe aparece `relay`.

# ------------------------------------------------------------------ 1. REDE
# IP PUBLICO do no que roda o coturn. E o equivalente do JVB_ADVERTISE_IPS:
# sem ele o coturn anuncia o IP do container, que nao existe fora do cluster.
# Hoje o Jitsi e o app respondem em 187.77.239.138 — confirme se o TURN sai
# pelo mesmo IP antes de copiar este valor.
TURN_PUBLIC_IP=

# O dominio precisa EXISTIR no DNS antes de subir: em 16/09/2026
# `turn.level33lab.cloud` nao resolve, e o Prosody entrega ao navegador um
# endereco que nao leva a lugar nenhum — mesmo efeito de nao ter TURN.
TURN_REALM=level33lab.cloud

# ------------------------------------------------------------- 2. SEGREDO
# O MESMO valor precisa ir em TURN_CREDENTIALS no .env do Jitsi. Se
# divergirem, o TURN recusa todo mundo sem dizer por que — e o sintoma volta a
# ser a chamada muda.
#
# Gerar:  openssl rand -hex 32
TURN_SECRET=

# ---------------------------------------------------------- 3. CERTIFICADO
# O coturn le o par do disco; ele nao fala com o Let's Encrypt sozinho. Se o
# Traefik ja emite por DNS challenge, o caminho mais curto e um job que exporte
# cert.pem e privkey.pem para esta pasta.
TURN_CERTS_PATH=/opt/certs/turn
