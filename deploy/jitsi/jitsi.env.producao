# Deltas do .env do Jitsi para PRODUCAO.
#
# Nao e um .env completo: sao as linhas que precisam MUDAR em relacao ao que o
# `scripts/preparar_jitsi.ps1` gera para a maquina de quem desenvolve. O resto
# (senhas de componente, JICOFO_AUTH_PASSWORD e afins) o script ja sorteia e
# deve ser mantido.
#
# Sem as tres primeiras secoes a chamada NAO FUNCIONA fora da rede local, e o
# sintoma nao ajuda: a sala abre, os dois entram, e ninguem ouve ninguem.

# ---------------------------------------------------------------- 1. ENDERECO
# O videobridge ANUNCIA este IP para o navegador do cliente. Hoje o valor local
# e 192.168.5.241 — endereco que so existe dentro do escritorio. Cliente de
# fora nao alcanca aquilo de jeito nenhum: nao e "rede dificil", e impossivel
# para todo mundo. Aqui vai o IP PUBLICO do no que roda o JVB.
JVB_ADVERTISE_IPS=SEU.IP.PUBLICO.AQUI

# O dominio publico. Precisa bater com JITSI_PUBLIC_URL no compose do Acervo.
PUBLIC_URL=https://meet.level33lab.cloud

# ---------------------------------------------------------------- 2. HTTPS
# `1` porque quem termina o TLS e o Traefik, na frente. O container `web`
# continua servindo HTTP na 8000 e o Traefik roteia por Host — o certificado
# sai do cfresolver, como no vig-agent.
#
# Isto e requisito, nao preferencia: navegador nenhum libera microfone fora de
# localhost sem certificado. Sem HTTPS a entrevista por chamada nao existe.
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0

# Labels do Traefik para o servico `web` (o compose do Jitsi nao os traz):
#   traefik.enable=true
#   traefik.docker.network=traefik-public
#   traefik.http.routers.jitsi.rule=Host(`meet.level33lab.cloud`)
#   traefik.http.routers.jitsi.entrypoints=websecure
#   traefik.http.routers.jitsi.tls=true
#   traefik.http.routers.jitsi.tls.certresolver=cfresolver
#   traefik.http.services.jitsi.loadbalancer.server.port=8000

# ---------------------------------------------------------------- 3. TURN
# O relay para quando o caminho direto nao fecha (4G, rede de empresa). Sobe
# pelo deploy/jitsi/docker-compose.coturn.yml.
#
# TURN_CREDENTIALS e o MESMO valor do --static-auth-secret do coturn. Se
# divergirem, o TURN recusa todo mundo sem dizer por que.
TURN_HOST=turn.level33lab.cloud
TURN_PORT=5349
TURN_TRANSPORT=tcp
TURN_CREDENTIALS=O-MESMO-SEGREDO-DO-COTURN
STUN_HOST=meet-jit-si-turnrelay.jitsi.net
STUN_PORT=443

# Efeito colateral bem-vindo: a imagem do Prosody so carrega o modulo
# `external_services` quando TURN_HOST existe. Com estas linhas preenchidas,
# param os dois `Strophe error: service-unavailable / get STUN/TURN
# credentials` que hoje aparecem no console a cada entrada na sala.

# ------------------------------------------------------- 4. AUTENTICACAO
# Hoje a sala e protegida so pelo nome — 256 bits sorteados pelo backend, que
# ninguem adivinha. E defensavel, e e o que esta em producao no desenho atual.
#
# Ligando AUTH_TYPE=jwt aqui, o Jitsi passa a EXIGIR token, e JITSI_JWT_APP_SECRET
# precisa ser preenchido no compose do Acervo com o MESMO valor de
# JWT_APP_SECRET abaixo. Meio preenchido derruba toda chamada.
ENABLE_AUTH=0
ENABLE_GUESTS=1
# AUTH_TYPE=jwt
# JWT_APP_ID=level33-chamadas
# JWT_APP_SECRET=
