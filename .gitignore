.venv/
__pycache__/
*.pyc
*.log
.pytest_cache/
tmp/
**/tests/amostras/
.paddlex/
run.stdout.log
run.stderr.log
rag-sincronizacao.log

# Documentos de clientes e o banco dos casos: nunca vão para o repositório.
#
# `dados/` seguido de `!dados/` NÃO ignorava nada: a segunda linha cancelava a
# primeira, e `dados/.portal-segredo`, `dados/casos.db`, `dados/entrevistas/` e
# `dados/contratos/` apareciam como arquivos comuns — um `git add -A` de
# qualquer pessoa commitaria CPF, laudo, gravação de atendimento e o segredo do
# portal. Nada disso chegou a ser commitado (conferido em todas as branches),
# mas a rede estava furada, e o comentário logo abaixo ainda afirmava que
# "`dados/` ja e ignorado".
#
# Apagar só o `!dados/` não resolve: com o DIRETÓRIO ignorado o Git não desce
# nele, e as exceções dos manifestos deixariam de valer. O padrão que funciona é
# ignorar o CONTEÚDO (`dados/*`) e reabrir caminho por caminho, um nível de cada
# vez — por isso cada pasta preservada aparece duas vezes.
dados/*
!dados/corpus_juridico/
dados/corpus_juridico/*
!dados/corpus_juridico/manifesto.json
!dados/legislacao_federal/
dados/legislacao_federal/*
!dados/legislacao_federal/manifesto.json

# Chaves de API. `dados/` ja e ignorado, mas .env na raiz e o lugar obvio onde
# alguem colocaria a proxima — e sem esta linha ela iria para o repositorio.
.env
.env.*
!.env.example

# Modelo de contrato do escritorio: fica fora do repositorio publico porque traz
# tabela de honorarios, CNPJ e as inscricoes na OAB. Para gerar contrato, ponha
# o .docx oficial em docs/ — o codigo pega qualquer CONTRATO*.docx, o mais
# recente primeiro (ver app/contrato.py).
**/docs/CONTRATO*.docx

# Saida do script de vetorizacao: barulho de execucao, nao codigo.
vetorizacao-*.log

# Saida dos servicos quando sobem soltos (fora do iniciar.ps1). O da transcricao
# e o mais serio: ele registra o nivel do audio e, em caso de erro, trecho do que
# foi dito pelo cliente. Isso e dado de atendimento, nao log de build.
# Os padroes cobrem o nome com e sem sufixo: `backend.*.log` sozinho NAO casa com
# `backend.log`, que e o nome gerado quando o uvicorn sobe na mao.
backend.log
backend.*.log
transcricao.log
transcricao.*.log
iniciar*.stdout.log
iniciar*.stderr.log

# Build do Next: gerado, nao versionado.
.next/
frontend/.next/

# Estado local do agendador Celery Beat. Estes arquivos mudam enquanto o
# processo roda e nunca devem fazer parte de commit ou merge.
celerybeat-schedule
celerybeat-schedule.*

# Dependencia do Next: baixada por `npm install`, nunca versionada. A ausencia desta
# linha ja custou caro uma vez — um `git add .` na raiz pos 10.022 arquivos do
# `node_modules` no indice, junto com o contrato do escritorio.
node_modules/

# Sobra da migracao feita por `migrar-raiz.ps1`: o projeto morava em `ocr-extrator/` e
# subiu para a raiz. O que ficou la e copia exata do que esta aqui (`dados/`, o contrato,
# as amostras) mais os gerados que o script nao conseguiu apagar porque havia processo
# segurando o arquivo. O `.dockerignore` ja a excluia do build; esta linha faz o mesmo
# pelo repositorio, para que ela nao volte ao indice enquanto a pasta nao for apagada.
ocr-extrator/

# Cache incremental do TypeScript: gerado a cada build.
*.tsbuildinfo

# Coleta bruta do DJEN: 24 arquivos, ~316 MB, refeitos pelo coletor
# (`scripts/coletar_djen_trts.py`). E insumo intermediario, nao codigo — e um
# repositorio nao e lugar de guardar 300 MB que qualquer maquina regenera.
decisoes_djen/
decisoes_limpas.json

# Capturas de falha da automacao da ZapSign (`ZAPSIGN_SCREENSHOT_DIR`).
_zapsign_debug/

# Arquivo de workspace do editor: e de quem edita, nao do projeto.
*.code-workspace
